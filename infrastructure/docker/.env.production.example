# Copy these names into the Dokploy Compose environment editor. Never commit real values.
COMPOSE_PROJECT_NAME=d-ceylon-production

# Use URL-safe random passwords because the application URL is assembled in compose.production.yaml.
POSTGRES_ADMIN_USER=dceylon_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-url-safe-random-password
POSTGRES_APP_DB=dceylon_app
POSTGRES_APP_USER=dceylon_app
POSTGRES_APP_PASSWORD=replace-with-a-long-url-safe-random-password

DIRECTUS_DB=directus
DIRECTUS_DB_USER=directus
DIRECTUS_DB_PASSWORD=replace-with-a-long-url-safe-random-password

REDIS_PASSWORD=replace-with-a-long-url-safe-random-password

DIRECTUS_SECRET=replace-with-at-least-32-random-characters
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
DIRECTUS_PUBLIC_URL=https://cms.example.com
DIRECTUS_STATIC_TOKEN=

# Production and staging authority/issuer URLs must use HTTPS.
AUTH_AUTHORITY=https://identity.example.com
AUTH_ISSUER=https://identity.example.com
AUTH_AUDIENCE=dceylon-api
AUTH_ROLE_CLAIM=roles
AUTH_PERMISSION_CLAIM=permissions
AUTH_ORGANISATION_CLAIM=organisation_id
AUTH_CUSTOMER_CLAIM=customer_id
