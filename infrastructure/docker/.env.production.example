# Copy these names into the Dokploy Compose environment editor. Never commit real values.
COMPOSE_PROJECT_NAME=d-ceylon-production

# Use URL-safe random passwords because the application URL is assembled in compose.production.yaml.
POSTGRES_ADMIN_USER=dceylon_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-url-safe-random-password
POSTGRES_APP_DB=dceylon_app
POSTGRES_APP_USER=dceylon_app
POSTGRES_APP_PASSWORD=replace-with-a-long-url-safe-random-password

REDIS_PASSWORD=replace-with-a-long-url-safe-random-password

JWT_ISSUER=dceylon-api
JWT_AUDIENCE=dceylon-api
JWT_ACCESS_SECRET=replace-with-a-different-64-character-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-service-account-email
FIREBASE_PRIVATE_KEY=replace-with-escaped-private-key

SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=D Ceylon <no-reply@example.com>
PASSWORD_RESET_URL=https://dceylon.example.com/auth/reset-password

# Supply these as frontend Docker build arguments, not backend runtime secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-web-app-id

# Runtime web setting. Restrict this browser key by HTTP referrer and to Maps JavaScript API.
GOOGLE_MAPS_API_KEY=replace-with-google-maps-browser-api-key
