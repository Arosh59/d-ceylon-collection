# Server-only ASP.NET Core API origin. Never expose credentials in NEXT_PUBLIC_* values.
API_BASE_URL=http://127.0.0.1:8080

# Canonical public origin used for absolute metadata.
SITE_URL=http://127.0.0.1:3000

# Runtime tier. Testing is accepted only by the isolated test-auth configuration.
APP_ENVIRONMENT=Development

# Standards-based OpenID Connect provider settings. Never prefix these with NEXT_PUBLIC_.
AUTH_ISSUER=https://identity.example.test
AUTH_CLIENT_ID=dceylon-web
AUTH_CLIENT_SECRET=replace-from-secret-store
AUTH_SCOPE=openid profile email dceylon.api

# At least 32 random characters, supplied through a secret store.
AUTH_SECRET=replace-with-a-random-session-secret

# Testing only. Omit in Development and Production.
# AUTH_TEST_ENDPOINT_KEY=replace-with-a-random-test-only-key
