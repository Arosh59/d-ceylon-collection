APP_ENVIRONMENT=Development
AUTH_MODE=local
AUTH_SECRET=local-admin-session-secret-change-before-sharing
API_BASE_URL=http://127.0.0.1:8080
NEXTAUTH_URL=http://127.0.0.1:3001
LOCAL_ADMIN_EMAIL=admin@dceylon.local
LOCAL_ADMIN_PASSWORD=change-me-local-admin-password

# Production uses AUTH_MODE=oidc and must load these values from the deployment secret store.
# AUTH_ISSUER=https://identity.example.test
# AUTH_CLIENT_ID=dceylon-admin
# AUTH_CLIENT_SECRET=replace-from-secret-store
