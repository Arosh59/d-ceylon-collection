APP_ENVIRONMENT=Development
API_BASE_URL=http://127.0.0.1:8080
# Public origin used for absolute authentication redirects in production.
PUBLIC_ADMIN_URL=http://127.0.0.1:3001
# Used by server-rendered admin preview links.
PUBLIC_WEB_URL=http://127.0.0.1:3000

# Firebase Web configuration for Google identity only. These values are public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
