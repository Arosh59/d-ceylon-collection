APP_ENVIRONMENT=Development
AUTH_MODE=oidc
AUTH_ISSUER=https://identity.example.test
AUTH_CLIENT_ID=dceylon-admin
AUTH_CLIENT_SECRET=replace-from-secret-store
AUTH_SECRET=replace-with-at-least-32-random-characters
API_BASE_URL=http://127.0.0.1:8080
NEXTAUTH_URL=http://127.0.0.1:3001

# Development-only administrator credentials when AUTH_MODE=local.
# LOCAL_ADMIN_EMAIL=admin@dceylon.local
# LOCAL_ADMIN_PASSWORD=replace-with-a-local-admin-password
