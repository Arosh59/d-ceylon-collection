# Server-only NestJS API origin.
API_BASE_URL=http://127.0.0.1:8080
SITE_URL=http://127.0.0.1:3000
APP_ENVIRONMENT=Development

# Firebase Web configuration for Google identity only. These values are public by design.
# Restrict Firebase authorized domains and API-key usage in Google Cloud.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Google Maps browser key. Restrict it to the site's HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Testing only. The user still supplies the independent key in the testing sign-in form.
# AUTH_TEST_ENDPOINT_KEY=
