# Copy this file to .env for local development and replace every placeholder.
# Never commit .env or real credentials.

POSTGRES_DB=dceylon
POSTGRES_USER=dceylon_app
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432

REDIS_PORT=6379

DIRECTUS_PORT=8055
DIRECTUS_KEY=replace-with-local-random-key
DIRECTUS_SECRET=replace-with-local-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.invalid
DIRECTUS_ADMIN_PASSWORD=replace-with-local-password

API_PORT=8080
WEB_PORT=3000
ADMIN_PORT=3001
AI_SERVICE_PORT=8000

# Optional local services; configure only when their Compose profiles are enabled.
OBJECT_STORAGE_ACCESS_KEY=replace-with-local-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-local-secret-key
MAIL_TESTING_PORT=8025
