# Create .env with ./scripts/create-local-env.sh, or copy this file and replace
# every placeholder manually. Never commit .env or real credentials.

COMPOSE_PROJECT_NAME=d-ceylon-local

POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=dceylon_admin
POSTGRES_ADMIN_PASSWORD=replace-with-local-random-admin-password
POSTGRES_APP_DB=dceylon_app
POSTGRES_APP_USER=dceylon_app
POSTGRES_APP_PASSWORD=replace-with-local-random-app-password

REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-random-redis-password

API_PORT=8080
WEB_PORT=3000
ADMIN_PORT=3001
ADMIN_SITE_URL=http://127.0.0.1:3001
AI_SERVICE_PORT=8000
API_BASE_URL=http://127.0.0.1:8080
SITE_URL=http://127.0.0.1:3000
# Browser-visible key for the destination map. Restrict it by HTTP referrer and to the Maps
# JavaScript API in Google Cloud. Leave empty when the map is intentionally disabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# NestJS-owned authentication.
APP_ENVIRONMENT=Development
JWT_ISSUER=dceylon-api
JWT_AUDIENCE=dceylon-api
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=D Ceylon <no-reply@example.test>
PASSWORD_RESET_URL=http://127.0.0.1:3000/auth/reset-password
AUTH_TEST_ISSUER=https://identity.test.dceylon.invalid
AUTH_TEST_AUDIENCE=dceylon-api
AUTH_TEST_SIGNING_KEY=
AUTH_TEST_ENDPOINT_KEY=

# Optional local services; configure only when their Compose profiles are enabled.
OBJECT_STORAGE_ACCESS_KEY=replace-with-local-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-local-secret-key
MAIL_TESTING_PORT=8025
