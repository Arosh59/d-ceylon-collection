# Create .env with ./scripts/create-local-env.sh, or copy this file and replace
# every placeholder manually. Never commit .env or real credentials.

COMPOSE_PROJECT_NAME=d-ceylon-local

POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=dceylon_admin
POSTGRES_ADMIN_PASSWORD=replace-with-local-random-admin-password
POSTGRES_APP_DB=dceylon_app
POSTGRES_APP_USER=dceylon_app
POSTGRES_APP_PASSWORD=replace-with-local-random-app-password

DIRECTUS_DB=directus
DIRECTUS_DB_USER=directus
DIRECTUS_DB_PASSWORD=replace-with-local-random-directus-db-password

REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-random-redis-password

DIRECTUS_PORT=8055
DIRECTUS_SECRET=replace-with-local-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.invalid
DIRECTUS_ADMIN_PASSWORD=replace-with-local-random-admin-password
DIRECTUS_PUBLIC_URL=http://localhost:8055

API_PORT=8080
WEB_PORT=3000
ADMIN_PORT=3001
AI_SERVICE_PORT=8000
API_BASE_URL=http://127.0.0.1:8080
SITE_URL=http://127.0.0.1:3000

# Optional local services; configure only when their Compose profiles are enabled.
OBJECT_STORAGE_ACCESS_KEY=replace-with-local-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-local-secret-key
MAIL_TESTING_PORT=8025
