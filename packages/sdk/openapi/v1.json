          }
        }
      },
      "DestinationSummaryResponse": {
        "required": ["id", "name", "slug", "summary", "heroMedia"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "heroMedia": {
            "oneOf": [
              {
                "type": "null"
              },
              {
