{
  "name": "d-ceylon-collection",
  "version": "0.0.0",
  "private": true,
  "description": "D Ceylon Collection travel platform monorepo",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "apps/admin",
    "apps/web",
    "packages/sdk"
  ],
  "overrides": {
    "eslint": "10.8.0",
    "js-yaml": "$js-yaml",
    "next@16.2.12": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    }
  },
  "scripts": {
    "build:admin": "npm run build --workspace=@dceylon/admin",
    "build:web": "npm run build --workspace=@dceylon/web",
    "dev": "./scripts/dev.sh",
    "dev:admin": "npm run dev --workspace=@dceylon/admin",
    "dev:web": "npm run dev --workspace=@dceylon/web",
    "format": "prettier --write --ignore-unknown apps/admin apps/web packages/sdk package.json package-lock.json",
    "format:check": "prettier --check --ignore-unknown apps/admin apps/web packages/sdk package.json package-lock.json",
    "lint:admin": "npm run lint --workspace=@dceylon/admin",
    "lint:web": "npm run lint --workspace=@dceylon/web",
    "sdk:generate": "npm run generate --workspace=@dceylon/sdk",
    "sdk:refresh": "node scripts/refresh-openapi.mjs",
    "sdk:verify": "node scripts/verify-web-api-contract.mjs",
    "test:web": "npm run test --workspace=@dceylon/web",
    "test:web:a11y": "npm run test:a11y --workspace=@dceylon/web",
    "test:web:smoke": "npm run test:smoke --workspace=@dceylon/web",
    "typecheck:admin": "npm run typecheck --workspace=@dceylon/admin",
    "typecheck:web": "npm run typecheck --workspace=@dceylon/web && npm run typecheck --workspace=@dceylon/sdk"
  },
  "devDependencies": {
    "eslint": "10.8.0",
    "js-yaml": "4.3.0",
    "postcss": "8.5.23",
    "prettier": "3.9.6",
    "sharp": "0.35.3"
  }
}
