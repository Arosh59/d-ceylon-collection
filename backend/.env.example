APP_ENVIRONMENT=Development
API_PORT=8080
DATABASE_URL=postgresql://dceylon_app:replace-me@127.0.0.1:5432/dceylon_app

# Generate independent values with: openssl rand -hex 32
JWT_ISSUER=dceylon-api
JWT_AUDIENCE=dceylon-api
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Firebase Admin credentials. Keep the private key server-side and preserve escaped newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Password recovery. Optional in Development; required in Staging and Production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=D Ceylon <no-reply@example.test>
PASSWORD_RESET_URL=http://127.0.0.1:3000/auth/reset-password
PASSWORD_RESET_TTL=1h

# Controlled administrator bootstrap (use only for the one-off command, then remove).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Testing only. Omit outside APP_ENVIRONMENT=Testing.
AUTH_TEST_ISSUER=https://identity.test.dceylon.invalid
AUTH_TEST_AUDIENCE=dceylon-api
AUTH_TEST_SIGNING_KEY=
AUTH_TEST_ENDPOINT_KEY=
