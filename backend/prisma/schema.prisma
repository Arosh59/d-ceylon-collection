// Refresh with `node scripts/generate-prisma-baseline.mjs --write` only while the legacy
// snapshots remain authoritative; review every migration diff before applying it.

model AgentAccount {
  id                            String @id(map: "PK_agents") @db.Uuid
  concurrencyToken              String @map("concurrency_token") @db.Uuid
  createdAtUtc                  DateTime @map("created_at_utc") @db.Timestamptz(6)
  isActive                      Boolean @map("is_active") @db.Boolean
  organisationId                String @map("organisation_id") @db.Uuid
  updatedAtUtc                  DateTime @map("updated_at_utc") @db.Timestamptz(6)
  userId                        String @map("user_id") @db.Uuid
  organisation                  Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, map: "FK_agents_organisations_organisation_id")
  @@unique([userId], map: "ux_agents_user_id")
  @@index([organisationId, isActive], map: "ix_agents_organisation_active")
  @@map("agents")
  @@schema("organisations_agents")
}

model ApplicationUser {
  id                            String @id(map: "PK_users") @db.Uuid
