  currency                      String @db.VarChar(3)
  customerNotes                 String? @map("customer_notes") @db.VarChar(2000)
  customerId                    String @map("customer_id") @db.Uuid
  internalNotes                 String? @map("internal_notes") @db.VarChar(2000)
  itineraryTitle                String @map("itinerary_title") @db.VarChar(200)
  organisationId                String? @map("organisation_id") @db.Uuid
  paidAmount                    Decimal @map("paid_amount") @db.Decimal(18, 2)
  quoteId                       String @map("quote_id") @db.Uuid
  quoteVersionId                String @map("quote_version_id") @db.Uuid
  status                        String @db.VarChar(40)
  totalAmount                   Decimal @map("total_amount") @db.Decimal(18, 2)
  travelEndDate                 DateTime @map("travel_end_date") @db.Date
  travelStartDate               DateTime @map("travel_start_date") @db.Date
  updatedAtUtc                  DateTime @map("updated_at_utc") @db.Timestamptz(6)
  items                         BookingItem[]
