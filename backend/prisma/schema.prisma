  issuer                        String @db.VarChar(500)
  lastAuthenticatedAtUtc        DateTime? @map("last_authenticated_at_utc") @db.Timestamptz(6)
  subject                       String @db.VarChar(200)
  updatedAtUtc                  DateTime @map("updated_at_utc") @db.Timestamptz(6)
  customerAccountRecords        CustomerAccount?
  userRoles                     UserRole[]
  @@index([email], map: "ix_users_email")
  @@index([isActive], map: "ix_users_is_active")
  @@unique([issuer, subject], map: "ux_users_issuer_subject")
  @@map("users")
  @@schema("identity_access")
}

model Arrival {
