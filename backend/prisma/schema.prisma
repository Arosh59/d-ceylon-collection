  @@unique([quoteId], map: "ux_bookings_quote")
  @@index([customerId, status, updatedAtUtc], map: "ix_bookings_customer_status_updated")
  @@index([organisationId, status, updatedAtUtc], map: "ix_bookings_organisation_status_updated")
  @@index([status, travelStartDate], map: "ix_bookings_status_start_date")
  @@map("bookings")
  @@schema("bookings")
}

